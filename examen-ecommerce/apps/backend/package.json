{
  "name": "kata-ecommerce-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API y Motor de Descuentos para Kata E-Commerce",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "db:init": "tsx src/infrastructure/database/init-db.ts",
    "db:view": "tsx src/infrastructure/database/view-db.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": ["ecommerce", "discounts", "tdd", "clean-architecture"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.1",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.0.5",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
