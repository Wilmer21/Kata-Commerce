# ==============================================================================
# Variables de Entorno — Kata E-Commerce Backend (Ejemplo sin secretos)
# ==============================================================================

# Puerto en el que escucha la API REST
PORT=3001

# Entorno de ejecución (development | test | production)
NODE_ENV=development

# Ruta del archivo de base de datos SQLite local
DB_PATH=./data/ecommerce.db

# Origen permitido para solicitudes CORS desde el frontend (Vite por defecto en 5173)
CORS_ORIGIN=http://localhost:5173
