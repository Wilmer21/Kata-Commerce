# ==============================================================================
# Variables de Entorno — Kata E-Commerce Backend (Ejemplo sin secretos)
# ==============================================================================

# Puerto en el que escucha la API REST
PORT=5000

# Entorno de ejecución (development | test | production)
NODE_ENV=development

# Ruta del archivo de base de datos SQLite local
DB_PATH=./data/ecommerce.db

# Origen permitido para solicitudes CORS desde el frontend (puerto 3000)
CORS_ORIGIN=http://localhost:3000
